# ============================================================
# Face Attendance System - Environment Configuration
# ============================================================

# Telegram Bot Configuration
# 1. Create bot: Message @BotFather on Telegram -> /newbot
# 2. Get Chat ID: Send message to your bot, then visit:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_bot_token_here_from_botfather
TELEGRAM_CHAT_ID=your_chat_id_here_from_getupdates

# API Configuration
API_BASE=http://localhost:8000
WS_URL=ws://localhost:8000/ws

# Database Configuration
DATABASE_PATH=database/attendance.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Environment
ENV=development

# Model Configuration
MODEL_PATH=model_store/
CONFIDENCE_THRESHOLD=0.7

# Detection Configuration
CAMERA_ID=0
DETECTION_INTERVAL=1.0
