# ============================================================
# Face Attendance System - Environment Configuration
# ============================================================
# ไฟล์นี้ใช้สำหรับ Server (app/server.py) เท่านั้น
# สำหรับ Detection config ให้แก้ที่ detection_prod/config.json
# ============================================================

# Telegram Bot Configuration
# 1. สร้าง bot: ส่งข้อความหา @BotFather บน Telegram -> /newbot
# 2. หา Chat ID: ส่งข้อความหา bot แล้วเปิด:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_bot_token_here_from_botfather
TELEGRAM_CHAT_ID=your_chat_id_here_from_getupdates
