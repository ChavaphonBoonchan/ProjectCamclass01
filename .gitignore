# ============================================================
# Face Attendance System - Git Ignore
# ============================================================

# ============================================================
# Python
# ============================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# ============================================================
# Machine Learning / AI Models
# ============================================================
# Model files
*.pkl
*.joblib
*.h5
*.hdf5
*.pb
*.pth
*.pt
*.onnx
*.tflite
*.mlmodel

# Training data and datasets (keep dataset/ folder)
# dataset/
datasets/
data/
training_data/
test_data/
validation_data/

# Model checkpoints and weights
checkpoints/
weights/
models/
saved_models/
model_store/*.pkl
model_store/*.joblib
model_store/*.h5

# Keep label_map.json but ignore other model files
!model_store/label_map.json

# Training logs and outputs
logs/
tensorboard_logs/
wandb/
mlruns/

# ============================================================
# Computer Vision / OpenCV
# ============================================================
# Image and video files
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
*.tif
*.webp
*.svg
*.ico
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.mkv
*.webm

# Keep sample images in docs
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.png
!docs/**/*.gif

# Detection outputs
detection_output/
detection_logs/
detection_debug/output/
detection_prod/output/

# ============================================================
# Database
# ============================================================
# SQLite databases
*.db
*.sqlite
*.sqlite3
database/*.db
database/*.sqlite
database/*.sqlite3

# Keep database schema files
!database/schema.sql
!database/init.sql

# Database backups
*.sql.bak
*.db.bak

# ============================================================
# Web App (Nuxt.js/Vue.js)
# ============================================================
# Dependencies
web_app/node_modules/
web_app/.npm
web_app/.pnpm-debug.log*
web_app/.yarn-integrity

# Nuxt.js build / generate output
web_app/.nuxt
web_app/.output
web_app/dist

# Nuxt.js runtime
web_app/.nitro
web_app/.cache

# Environment variables
web_app/.env
web_app/.env.local
web_app/.env.development.local
web_app/.env.test.local
web_app/.env.production.local

# Logs
web_app/logs
web_app/*.log
web_app/npm-debug.log*
web_app/yarn-debug.log*
web_app/yarn-error.log*
web_app/lerna-debug.log*
web_app/.pnpm-debug.log*

# Runtime data
web_app/pids
web_app/*.pid
web_app/*.seed
web_app/*.pid.lock

# Coverage directory used by tools like istanbul
web_app/coverage
web_app/*.lcov

# nyc test coverage
web_app/.nyc_output

# ESLint cache
web_app/.eslintcache

# Optional npm cache directory
web_app/.npm

# Optional eslint cache
web_app/.eslintcache

# Microbundle cache
web_app/.rpt2_cache/
web_app/.rts2_cache_cjs/
web_app/.rts2_cache_es/
web_app/.rts2_cache_umd/

# Optional REPL history
web_app/.node_repl_history

# Output of 'npm pack'
web_app/*.tgz

# Yarn Integrity file
web_app/.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
web_app/.cache
web_app/.parcel-cache

# Next.js build output
web_app/.next

# Nuxt.js build / generate output
web_app/.nuxt
web_app/dist

# Storybook build outputs
web_app/.out
web_app/.storybook-out

# Temporary folders
web_app/tmp/
web_app/temp/

